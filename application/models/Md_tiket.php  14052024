    function getAllPicSupport($id_tiket)
    {
        $this->db->select('
                tdps.id_tiket,
                tdps.id_pic_support,
				p.nama as nama_pic
            ')
            ->from('tiket_detail_pic_support tdps')
            ->join('pengguna p', 'tdps.id_pic_support=p.pengguna_id')
            ->where('tdps.id_tiket', $id_tiket)
            ->order_by('tdps.id', 'DESC');
        return $this->db->get()->result();
    }
