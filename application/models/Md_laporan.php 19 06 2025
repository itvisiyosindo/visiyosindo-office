	public function getByJobs($id)
	{
			$sql = "SELECT 
									f.id AS id_pod,
									f.id_jobdesc,
									f.nilai,
									f.point,
									f.idPengguna,
									f.deskripsi,
									f.status
							FROM jobdesc_detail f
							WHERE f.idPengguna = ? 
							AND f.status = 1
							ORDER BY f.id ASC";
			
			$query = $this->db->query($sql, array($id));
			return $query->result(); // Mengembalikan hasil query dalam bentuk array objek
	}


