<script>
    document.addEventListener('DOMContentLoaded', function() {
        $(document).on('click', '.btn-reset-password', function() {
            var object = 'pengguna'
            // var id = $(this).data("id")
            // $('#main-modal #pengguna_id').val(id)
            $('#main-modal #modal-label').html('<i class="fa fa-refresh"></i> Form Reset Password')
            $('#main-modal #modal-form').attr('action', object + '/reset')
            $('#main-modal').modal()
            togglePasswordForm('show')
        })

        $(document).on('click', '.btn-file', function() {
            $('#file-modal .form-control').val(null)
            $('#file-modal').modal()

            var id = $(this).attr("data-id")
            var object = $(this).attr("action-type")

            $('#file-modal #file-form').attr('action', 'pengguna/update/file/' + object)
            $('#file-modal #file_input').attr('name', object);
            $('#file-modal #object').val(object)

        })

        $(document).on('click', '#btn-lihat', function() {
            var id = $('#file-modal #pengguna_id').val()
            var object = $('#file-modal #object').val()

            $.ajax({
                method: 'POST',
                url: 'pengguna/show/lihat_file',
                dataType: 'JSON',
                data: {
                    id: id,
                    object: object,
                    csrf_token: token
                },
                success: function(name) {
                    if (name) {
                        var link = 'uploads/file_karyawan/' + object + '/' + name
                        window.open('<?= base_url() ?>' + link)
                    } else {
                        alert('file tidak ada!')
                    }
                }
            })
        })

        $(document).on('click', '#btn-download', function() {
            var id = $('#file-modal #pengguna_id').val()
            var object = $('#file-modal #object').val()

            var link = 'pengguna/show/download_file/' + id + '/' + object
            window.open('<?= base_url() ?>' + link)
        })
    })

    function goBack() {
        window.history.back();
    }
</script>