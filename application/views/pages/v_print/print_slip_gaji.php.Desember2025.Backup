            <td class="table-border-right" style="text-align: right; width: 25%"><?= (!empty($dtsalary->tunjangankonsumsi) ?  rupiah($dtsalary->tunjangankonsumsi) : '-') ?></td>
            <th style="text-align: left;">2. BPJS Kesehatan</th>
            <td>=</td>
            <td>Rp.</td>
            <td style="text-align: right; width: 25%"><?= (!empty($dtsalary->bpjskesehatan) ?  rupiah($dtsalary->bpjskesehatan) : '-') ?></td>
          </tr>
          <tr>
            <th style="text-align: left;">3. Tunjangan Kinerja</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->tunjangankinerja) ?  rupiah($dtsalary->tunjangankinerja) : '-') ?></td>
            <th style="text-align: left; width: 38%;">3. BPJS Ketenagakerjaan</th>
            <td>=</td>
            <td>Rp.</td>
            <td style="text-align: right;"><?= (!empty($dtsalary->bpjstk) ?  rupiah($dtsalary->bpjstk) : '-') ?></td>
          </tr>
          <tr>
            <th style="text-align: left; width: 38%;">4. Tunjangan Komunikasi</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->tunjangankomunikasi) ?  rupiah($dtsalary->tunjangankomunikasi) : '-') ?></td>
            <th style="text-align: left;">4. Potongan Lainnya</th>
            <td>=</td>
            <td>Rp.</td>
            <td style="text-align: right;"><?= !empty($potonganlain) ? rupiah($potonganlain) : '-'; ?></td>
          </tr>
          <tr>
            <th style="text-align: left;">5. Tunjangan Transport</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->tunjangantransport) ?  rupiah($dtsalary->tunjangantransport) : '-') ?></td>
            <th style="text-align: left;"></th>
            <td></td>
            <td></td>
            <td></td>
          </tr>
          <tr>
            <th style="text-align: left;">6. Tunjangan Jabatan</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->tunjanganjabatan) ?  rupiah($dtsalary->tunjanganjabatan) : '-') ?></td>
            <th style="text-align: left;"></th>
            <td></td>
            <td></td>
            <td></td>
          </tr>
          <tr>
            <th style="text-align: left;">7. Bonus</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->bonus) ?  rupiah($dtsalary->bonus) : '-') ?></td>
            <th style="text-align: left;"></th>
            <td></td>
            <td></td>
            <td></td>
          </tr>
          <tr>
            <th style="text-align: left;">8. Tunjangan Hari Raya (THR)</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->tunjanganraya) ?  rupiah($dtsalary->tunjanganraya) : '-') ?></td>
            <th style="text-align: left;"></th>
            <td></td>
            <td></td>
            <td></td>
          </tr>
          <tr>
            <th style="text-align: left;">9. Pendapatan Lainnya</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->pendapatanlain_tidaktetap) ?  rupiah($dtsalary->pendapatanlain_tidaktetap) : '-') ?></td>
            <th style="text-align: left;"></th>
            <td></td>
            <td></td>
            <td></td>
          </tr>

          <tr>
            <th class="table-border" colspan="1" style="text-align: left;">Total A</th>
            <th class="table-border"></th>
            <th class="table-border" style="width: fit-content;">Rp.</th>
            <th class="table-border" colspan="1" style="text-align: right;  border-right: 1px solid;"><?= ($total_a > 0 ? rupiah($total_a) : '-') ?></th>
            <th class="table-border" colspan="2" style="text-align: left;">Total B</th>
            <th class="table-border" style="width: fit-content;">Rp.</th>
            <th class="table-border" colspan="1" style="text-align: right;"><?= ($total_b > 0 ? rupiah($total_b) : '-') ?></th>
          </tr>
          <tr>
            <th class="table-border" colspan="6" style="text-align: left;">TAKE HOME PAY (A-B) </th>
            <th class="table-border" style=" text-align: right; width: fit-content;">Rp.</th>
            <th class="table-border" colspan="1" style="text-align: right;"><?= ($thp != 0 ? rupiah($thp) : '-') ?></th>
          </tr>
          <tr>
            <th colspan="8" style="text-align: left;">TERBILANG : </th>
          </tr>
          <tr>
            <td colspan="8" style="text-align: left;"><i><?= ($thp != 0 ? penyebut($thp) : 'Nol Rupiah') ?></i></td>
