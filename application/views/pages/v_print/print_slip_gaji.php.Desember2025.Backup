      <tbody>
        <?php
        // Langkah 2: Cek apakah data $dtsalary ada (tidak null/kosong)
        if (!empty($dtsalary)) :

          // Jika data ADA, hitung total terlebih dahulu
          $total_a = ($dtsalary->gajipokok ?? 0) +
            ($dtsalary->tunjangankonsumsi ?? 0) +
            ($dtsalary->tunjangankinerja ?? 0) +
            ($dtsalary->tunjangankomunikasi ?? 0) +
            ($dtsalary->tunjangantransport ?? 0) +
            ($dtsalary->tunjanganjabatan ?? 0) +
            ($dtsalary->bonus ?? 0) +
            ($dtsalary->tunjanganraya ?? 0) +
            ($dtsalary->pendapatanlain_tidaktetap ?? 0);

          $total_b = ($dtsalary->bpjskesehatan ?? 0) +
            ($dtsalary->bpjstk ?? 0) +
            ($dtsalary->pph21 ?? 0) +
            ($potonganlain ?? 0);

          $thp = $total_a - $total_b;
        ?>

          <tr>
            <th style="text-align: left;">1. Gaji Pokok</th>
            <td>=</td>
            <td>Rp.</td>
            <td class="table-border-right" style="text-align: right;"><?= (!empty($dtsalary->gajipokok) ?  rupiah($dtsalary->gajipokok) : '-') ?></td>
            <th style="text-align: left;">1. Pph Pasal 21</th>
            <td>=</td>
            <td>Rp.</td>
            <td style="text-align: right;"><?= (!empty($dtsalary->pph21) ?  rupiah($dtsalary->pph21) : '-') ?></td>
