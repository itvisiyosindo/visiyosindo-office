	<script>
		document.addEventListener('DOMContentLoaded', function() {
		/*table = $('#kt_table_1').DataTable({
				responsive: false,
				processing: true,
				serverSide: true,

				ajax: {
						url: 'ekspedisi/paginationDestinasi',
						type: 'POST',
						data: function(e) {
								e.csrf_token = token
						}
				},
				order: [[1, 'asc'], [2, 'asc']], // Kolom ke-1: provinsi, kolom ke-2: kab_kota
				columnDefs: [
						{
								targets: [0,3], className: 'text-center' // No urut
						},
						{
								targets: [1,2], className: 'text-left' // provinsi & kab_kota
						}
				]
		});*/

		table = $('#kt_table_1').DataTable({
			responsive: false,
			processing: true,
			serverSide: true,
			order: [[0, 'desc']],
			ajax: {
				url: 'ekspedisi/paginationDestinasi',
				type: 'POST',
				data: function(e) {
					e.csrf_token = token;
				}
			},
			order: [[1, 'asc'], [2, 'asc']],
			columnDefs: [
					{ targets: [0, 3], className: 'text-center', searchable: false },
					{ targets: [1, 2], className: 'text-left', searchable: false },
					{ targets: [1, 2], searchable: true },
			]

		});



		$('#btn-laporan-form').click(function() {
					$('#file-modal .form-control').val(null);
					$('#file-modal').modal();
					$('#file-modal #file-form').attr('action', 'ekspedisi/importDestinasi');

					$('#file-modal #object').val(object); 
			});

			$("#btn-download").click(function(){
          window.open("<?php echo base_url(); ?>ekspedisi/exportDestinasi","_blank");
          $('#file-modal').modal('hide')
			
      });



			$('#btn-show-add-form').click(function() {
			$('.form-control').val(null)
			$('#main-modal #modal-form').attr('action', 'ekspedisi/addDestinasi')
			$('#main-modal').modal()
		})

		$(document).on('click', '.btn-edit', function() {
			var object = 'ekspedisi'
			$('#main-modal #modal-form').attr('action', 'ekspedisi/updateDestinasi')
			$('#main-modal').modal()

			var id = $(this).attr("data-id")
			fetch(object + '/editDestinasi/' + id)
				.then(function(resp) {
					return resp.json()
				})
				.then(function(data) {
					$('#main-modal #id_ekspedisi').val(data[0].id)
					$('#main-modal #provinsi').val(data[0].provinsi)
					$('#main-modal #kab_kota').val(data[0].kab_kota)
				})
		})


		// 6. Load Provinsi Unik + Input Lainnya
    $.getJSON("<?= site_url('ekspedisi/getProvinsiList') ?>", function (data) {
        $.each(data, function (i, val) {
            if (val.provinsi && val.provinsi.trim() !== '') {
                $('#provinsi').append('<option value="' + val.provinsi + '">' + val.provinsi + '</option>');
            }
        });
        $('#provinsi').append('<option value="__lainnya__">Input lainnya...</option>');
    });

    // 7. Tampilkan input provinsi jika pilih “lainnya”
    $('#provinsi').on('change', function () {
        if ($(this).val() === '__lainnya__') {
            $('#provinsi_lainnya').show().prop('required', true);
        } else {
            $('#provinsi_lainnya').hide().prop('required', false);
        }
    });


		
		

		
	})




	$(document).ready(function () {
    $.getJSON("<?= site_url('ekspedisi/getProvinsiList') ?>", function (data) {
        $.each(data, function (i, val) {
            if (val.provinsi && val.provinsi.trim() !== '') {
                $('#provinsi').prepend('<option value="' + val.provinsi + '">' + val.provinsi + '</option>');
            }
        });
    });

    $('#provinsi').on('change', function () {
        if ($(this).val() === '__lainnya__') {
            $('#provinsi_lainnya').show().prop('required', true);
        } else {
            $('#provinsi_lainnya').hide().prop('required', false);
        }
    });
});


function updateDatatable() {
		table.ajax.reload(null, false)
	}

	</script>

	