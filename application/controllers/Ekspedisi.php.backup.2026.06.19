        $th[] = $li_btn;*/

        $th[] = ++$start . '.';
        $th[] = $row->provinsi;
        $th[] = $row->kab_kota;

        // PKU
        $pkuText = ($row->pku !== null && $row->pku !== '') ? 'Rp ' . number_format($row->pku, 0, ',', '.') : '-';
        $estPkuText = ($row->est_pku !== null && $row->est_pku !== '' && $row->est_pku != 0) ? $row->est_pku . ' Hari' : '-';
        if ($row->fix_pku == 1) {
            $pkuText = '<b>' . $pkuText . '</b>';
