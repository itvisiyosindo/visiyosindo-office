public function paginationDetailNamaBarangOLD()
{
    header('Content-Type: application/json');

    $id_destinasi = $this->input->post('id_destinasi');
    $jumlah       = (int) $this->input->post('jumlah');
    $acuan_berat  = (float) $this->input->post('acuan_berat');
    $layanan      = (float) $this->input->post('layanan');
    $asal         = $this->input->post('asal'); // pku, jkt, atau jogja

    if (!$id_destinasi || !$jumlah || !$asal) {
        echo json_encode([
            "draw" => 0,
            "recordsTotal" => 0,
            "recordsFiltered" => 0,
            "data" => [],
            "error" => "Parameter tidak lengkap"
        ]);
        return;
    }

    $list = $this->md_ekspedisi->getDataPerbandingan($id_destinasi, $jumlah, $acuan_berat, $layanan, $asal);
    $data = [];
    $no   = 1;

    $semuaKosong = true;
    foreach ($list as $row) {
        if ($row->harga_final !== null && $row->harga_final > 0) {
            $semuaKosong = false;
        }

        $harga    = $row->harga_final; // * $jumlah;
        //$estimasi = $row->estimasi;

        $data[] = [
            $no++,
            $row->nama_ekspedisi,
            ((float)$row->berat_ekspedisi > 0) ? $row->berat_ekspedisi . ' Kg' : 'Tidak ada',
            ($row->harga_final !== null) ? 'Rp ' . number_format($harga, 0, ',', '.') : 'Belum diinput',
            ((float)$row->estimasi > 0) ? $row->estimasi . ' Hari' : 'Tidak ada'
        ];
    }

    echo json_encode([
        "draw" => intval($this->input->post('draw') ?? 1),
        "recordsTotal" => count($data),
        "recordsFiltered" => count($data),
        "data" => $data,
        "message" => $semuaKosong ? "Harga untuk kota tujuan ini belum diinput oleh tim warehouse." : null
    ]);
}


public function paginationDetailNamaBarang()
{
    header('Content-Type: application/json');

    $id_destinasi = $this->input->post('id_destinasi');
    $jumlah       = (int) $this->input->post('jumlah');
    $acuan_berat  = (float) $this->input->post('acuan_berat');
    $layanan      = (float) $this->input->post('layanan');
    $asal         = $this->input->post('asal'); // pku, jkt, atau jogja

    if (!$id_destinasi || !$jumlah || !$asal) {
        echo json_encode([
            "draw" => 0,
            "recordsTotal" => 0,
            "recordsFiltered" => 0,
            "data" => [],
            "error" => "Parameter tidak lengkap"
        ]);
        return;
    }

    $list = $this->md_ekspedisi->getDataPerbandingan($id_destinasi, $jumlah, $acuan_berat, $layanan, $asal);
    $data = [];
    $no   = 1;

    /*foreach ($list as $row) {
        // Lewati ekspedisi yang tidak punya harga
        if ($row->harga_final === null || $row->harga_final <= 0) {
            continue;
        }

        $harga = $row->harga_final;

        $data[] = [
            $no++,
            $row->nama_ekspedisi,
            ((float)$row->berat_ekspedisi > 0) ? $row->berat_ekspedisi . ' Kg' : 'Tidak ada',
            'Rp ' . number_format($harga, 0, ',', '.'),
            ((float)$row->estimasi > 0) ? $row->estimasi . ' Hari' : 'Tidak ada'
        ];
    }*/

    foreach ($list as $row) {
        if ($row->harga_final === null || $row->harga_final <= 0) {
            continue;
        }

        $harga = 'Rp ' . number_format($row->harga_final, 0, ',', '.');
        $estimasi = ((float)$row->estimasi > 0) ? $row->estimasi . ' Hari' : 'Tidak ada';

        // Bold kalau fix == 1
        if ((int)$row->fix === 1) {
            $harga = '<strong>' . $harga . '</strong>';
            $estimasi = '<strong>' . $estimasi . '</strong>';
        }

        $data[] = [
            $no++,
            $row->nama_ekspedisi,
            ((float)$row->berat_ekspedisi > 0) ? $row->berat_ekspedisi . ' Kg' : 'Tidak ada',
            $harga,
            $estimasi
        ];
    }



    echo json_encode([
        "draw" => intval($this->input->post('draw') ?? 1),
        "recordsTotal" => count($data),
        "recordsFiltered" => count($data),
        "data" => $data,
        // tampilkan pesan hanya jika semua kosong
        "message" => (count($data) === 0) ? "Harga untuk kota tujuan ini belum diinput oleh tim warehouse." : null
    ]);
}










