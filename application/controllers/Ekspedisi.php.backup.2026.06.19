        $th[] = $pkuText;
        $th[] = $estPkuText;

        // JKT
        $jktText = ($row->jkt !== null && $row->jkt !== '') ? 'Rp ' . number_format($row->jkt, 0, ',', '.') : '-';
        $estJktText = ($row->est_jkt !== null && $row->est_jkt !== '' && $row->est_jkt != 0) ? $row->est_jkt . ' Hari' : '-';
        if ($row->fix_jkt == 1) {
            $jktText = '<b>' . $jktText . '</b>';
            $estJktText = '<b>' . $estJktText . '</b>';
        }
        $th[] = $jktText;
        $th[] = $estJktText;

        // Jogja
        $jogjaText = ($row->jogja !== null && $row->jogja !== '') ? 'Rp ' . number_format($row->jogja, 0, ',', '.') : '-';
        $estJogjaText = ($row->est_jogja !== null && $row->est_jogja !== '' && $row->est_jogja != 0) ? $row->est_jogja . ' Hari' : '-';
        if ($row->fix_jogja == 1) {
            $jogjaText = '<b>' . $jogjaText . '</b>';
            $estJogjaText = '<b>' . $estJogjaText . '</b>';
        }
        $th[] = $jogjaText;
        $th[] = $estJogjaText;

        $th[] = $li_btn;

        $data[] = $th;
        }
        $dt['data'] = $data;
        echo json_encode($dt);
        die;
    }



public function importPricelist() {

    $idEkspedisi = $this->input->post('id_ekspedisi2') ?? $this->input->get('id_ekspedisi2');
    if (empty($idEkspedisi)) {
        show_error('ID Ekspedisi tidak diberikan.');
    }

    
    $file_mimes = array(
        'application/octet-stream', 'application/vnd.ms-excel', 'application/x-csv',
        'text/x-csv', 'text/csv', 'application/csv', 'application/excel',
        'application/vnd.msexcel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
    );

    if (isset($_FILES['berkas_excel']['name']) && in_array($_FILES['berkas_excel']['type'], $file_mimes)) {
        $arr_file = explode('.', $_FILES['berkas_excel']['name']);
        $extension = end($arr_file);

        if ('csv' == $extension) {
            $reader = new \PhpOffice\PhpSpreadsheet\Reader\Csv();
        } else {
            $reader = new \PhpOffice\PhpSpreadsheet\Reader\Xlsx();
        }

        $spreadsheet = $reader->load($_FILES['berkas_excel']['tmp_name']);
        $sheetData = $spreadsheet->getActiveSheet()->toArray();

        for ($i = 2; $i < count($sheetData); $i++) {
            $id = isset($sheetData[$i][0]) ? $sheetData[$i][0] : null;
            $idEks = isset($sheetData[$i][1]) ? $sheetData[$i][1] : null;

            $data = [
                'pku'      => isset($sheetData[$i][4]) ? $sheetData[$i][4] : '',
                'fix_pku'  => isset($sheetData[$i][5]) ? $sheetData[$i][5] : '',
                'est_pku'  => isset($sheetData[$i][6]) ? $sheetData[$i][6] : '',
                'jkt'      => isset($sheetData[$i][7]) ? $sheetData[$i][7] : '',
                'fix_jkt'  => isset($sheetData[$i][8]) ? $sheetData[$i][8] : '',
                'est_jkt'  => isset($sheetData[$i][9]) ? $sheetData[$i][9] : '',
                'jogja'    => isset($sheetData[$i][10]) ? $sheetData[$i][10] : '',
                'fix_jogja'  => isset($sheetData[$i][11]) ? $sheetData[$i][11] : '',
                'est_jogja'  => isset($sheetData[$i][12]) ? $sheetData[$i][12] : '',
            ];

            if (empty($id) || empty($idEks)) {
                continue;
            }

            if (!empty($id) && $this->md_ekspedisi->cekPricelistExist($id, $idEks)) {
                // Update jika id sudah ada
                $this->md_ekspedisi->updatePricelist($id, $idEks, $data);
            } else {
                // Insert baru
                $data['id_destinasi'] = $id; // Jika ID diberikan di Excel
                $data['id_ekspedisi'] = $idEks; // Jika ID diberikan di Excel
                $this->md_ekspedisi->addPricelist($data);
            }
        }

        // Log aktivitas
        addlog('Edit Master Data', 'Melakukan Import Pricelist ID Ekspedisi:'.$idEkspedisi);
        redirect('/ekspedisi/show/detail/pricelist/'.$idEkspedisi);
    }
}




public function exportPricelist()
{
    $idEkspedisi = $this->input->get('id_ekspedisi'); 

    $data = $this->md_ekspedisi->getAllPricelistExport($idEkspedisi);

    $ekspedisi = $this->md_ekspedisi->getById($idEkspedisi); 

    $nama_ekspedisi = $ekspedisi[0]->nama_ekspedisi; 


    $spreadsheet = new Spreadsheet;
    $sheet = $spreadsheet->getActiveSheet();

    // Style header kolom
    $style_col = [
        'font' => ['bold' => true],
        'alignment' => [
            'horizontal' => \PhpOffice\PhpSpreadsheet\Style\Alignment::HORIZONTAL_CENTER,
            'vertical' => \PhpOffice\PhpSpreadsheet\Style\Alignment::VERTICAL_CENTER
        ],
        'borders' => [
            'top' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'right' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'bottom' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'left' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN]
        ]
    ];

    // Style isi tabel
    $style_row = [
        'alignment' => [
            'vertical' => \PhpOffice\PhpSpreadsheet\Style\Alignment::VERTICAL_CENTER
        ],
        'borders' => [
            'top' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'right' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'bottom' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'left' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN]
        ]
    ];

    // Judul
    $sheet->setCellValue('A1', "Format Pricelist Ekspedisi - " . strtoupper($nama_ekspedisi));
    $sheet->mergeCells('A1:G1');
    $sheet->getStyle('A1')->getFont()->setBold(true);

    // Header kolom
    $sheet->setCellValue('A2', 'ID Daerah');
    $sheet->setCellValue('B2', 'ID Ekspedisi');
    $sheet->setCellValue('C2', 'Provinsi');
    $sheet->setCellValue('D2', 'Kabupaten Kota');
    $sheet->setCellValue('E2', 'Ongkir dari Gudang PKU (Per Kg)');
    $sheet->setCellValue('F2', '1=Fix 2=Estimasi');
    $sheet->setCellValue('G2', 'Estimasi (Hari)');
    $sheet->setCellValue('H2', 'Ongkir dari Gudang JKT (Per Kg)');
    $sheet->setCellValue('I2', '1=Fix 2=Estimasi');
    $sheet->setCellValue('J2', 'Estimasi (Hari)');
    $sheet->setCellValue('K2', 'Ongkir dari Gudang Jogja (Per Kg)');
    $sheet->setCellValue('L2', '1=Fix 2=Estimasi');
    $sheet->setCellValue('M2', 'Estimasi (Hari)');
    $sheet->getStyle('A2')->applyFromArray($style_col);
    $sheet->getStyle('B2')->applyFromArray($style_col);
    $sheet->getStyle('C2')->applyFromArray($style_col);
    $sheet->getStyle('D2')->applyFromArray($style_col);
    $sheet->getStyle('E2')->applyFromArray($style_col);
    $sheet->getStyle('F2')->applyFromArray($style_col);
    $sheet->getStyle('G2')->applyFromArray($style_col);
    $sheet->getStyle('H2')->applyFromArray($style_col);
    $sheet->getStyle('I2')->applyFromArray($style_col);
    $sheet->getStyle('J2')->applyFromArray($style_col);
    $sheet->getStyle('K2')->applyFromArray($style_col);
    $sheet->getStyle('L2')->applyFromArray($style_col);
    $sheet->getStyle('M2')->applyFromArray($style_col);

    // Data
    $startRow = 3;
    $kolom = $startRow;
    foreach ($data as $item) {
        $sheet->setCellValue('A' . $kolom, $item->idEd);
        $sheet->setCellValue('B' . $kolom, $idEkspedisi);
        $sheet->setCellValue('C' . $kolom, $item->provinsi);
        $sheet->setCellValue('D' . $kolom, $item->kab_kota);
        $sheet->setCellValue('E' . $kolom, $item->pku);
        $sheet->setCellValue('F' . $kolom, ($item->fix_pku === null ? 2 : $item->fix_pku));
        $sheet->setCellValue('G' . $kolom, $item->est_pku);
        $sheet->setCellValue('H' . $kolom, $item->jkt);
        $sheet->setCellValue('I' . $kolom, ($item->fix_jkt === null ? 2 : $item->fix_jkt));
        $sheet->setCellValue('J' . $kolom, $item->est_jkt);
        $sheet->setCellValue('K' . $kolom, $item->jogja);
        $sheet->setCellValue('L' . $kolom, ($item->fix_jogja === null ? 2 : $item->fix_jogja));
        $sheet->setCellValue('M' . $kolom, $item->est_jogja);


        $sheet->getStyle('A' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('B' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('C' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('D' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('E' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('F' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('G' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('H' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('I' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('J' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('K' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('L' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('M' . $kolom)->applyFromArray($style_row);

        $kolom++;
        
    }

    // Set ukuran kolom
    $sheet->getColumnDimension('A')->setWidth(15);
    $sheet->getColumnDimension('B')->setWidth(18);
    $sheet->getColumnDimension('C')->setWidth(25);
    $sheet->getColumnDimension('D')->setWidth(40);
    $sheet->getColumnDimension('E')->setWidth(35);
    $sheet->getColumnDimension('F')->setWidth(16);
    $sheet->getColumnDimension('G')->setWidth(15);
    $sheet->getColumnDimension('H')->setWidth(35);
    $sheet->getColumnDimension('I')->setWidth(10);
    $sheet->getColumnDimension('J')->setWidth(16);
    $sheet->getColumnDimension('K')->setWidth(35);
    $sheet->getColumnDimension('L')->setWidth(16);
    $sheet->getColumnDimension('M')->setWidth(15);
    $sheet->getDefaultRowDimension()->setRowHeight(-1);
    $sheet->getPageSetup()->setOrientation(\PhpOffice\PhpSpreadsheet\Worksheet\PageSetup::ORIENTATION_LANDSCAPE);
    $sheet->setTitle("Ekspedisi");
    
    // Proteksi seluruh sheet
    $sheet->getProtection()->setSheet(true);
    $sheet->getProtection()->setPassword('12345');

    // Kunci kolom A-D
    $sheet->getStyle('A3:D1000')->getProtection()->setLocked(\PhpOffice\PhpSpreadsheet\Style\Protection::PROTECTION_PROTECTED);

    // Buka kunci kolom E-G (agar bisa diisi)
    $sheet->getStyle('E3:M1000')->getProtection()->setLocked(\PhpOffice\PhpSpreadsheet\Style\Protection::PROTECTION_UNPROTECTED);


    ob_end_clean();
    $clean_name = str_replace(' ', '_', strtolower($nama_ekspedisi)); // misal: "JNE Express" → "jne_express"
    $filename = "format_pricelist_" . $clean_name . ".xlsx";

    header('Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    header("Content-Disposition: attachment; filename=\"$filename\"");
    header('Cache-Control: max-age=0');
    $writer = new Xlsx($spreadsheet);
    $writer->save('php://output');
}


public function editPricelist($param1)
{
    grantAccessFor('all');
    $id = decrypt($param1);
    $dt = $this->md_ekspedisi->getByIdPricelist($id);
    foreach ($dt as $row) {
        $row->idPrice = encrypt($row->idPrice);
    }
    echo json_encode($dt);
    die;
}

public function updatePricelist()
{        
    grantAccessFor('all');
    $id = decrypt($this->input->post('id_ekspedisi'));
    $data['pku']        = $this->input->post('pku', TRUE);
    $data['jkt']        = $this->input->post('jkt', TRUE);
    $data['jogja']      = $this->input->post('jogja', TRUE);
    $data['fix_pku']    = $this->input->post('fix_pku', TRUE);
    $data['fix_jkt']    = $this->input->post('fix_jkt', TRUE);
    $data['fix_jogja']  = $this->input->post('fix_jogja', TRUE);
    $data['est_pku']    = $this->input->post('est_pku', TRUE);
    $data['est_jkt']    = $this->input->post('est_jkt', TRUE);
    $data['est_jogja']  = $this->input->post('est_jogja', TRUE);
           
    $this->md_ekspedisi->updatePricelist2($id, $data);

    /** LOG */
    addLog('Pricelist Ekspedisi', 'Memperbarui Pricelist Ekspedisi ID ' .$id);
    ajaxReturnDie('success', 'Data berhasil diperbarui', TRUE);
}



