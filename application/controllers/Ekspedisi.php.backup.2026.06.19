public function getProvinsiList()
{
    $provinsi = $this->md_ekspedisi->getUniqueProvinsi();
    echo json_encode($provinsi);
}


public function addDestinasi()
{
    grantAccessFor('all');

    $provinsi = $this->input->post('provinsi') == '__lainnya__' 
        ? $this->input->post('provinsi_lainnya') 
        : $this->input->post('provinsi');

    $data['provinsi']  = $provinsi; 
    $data['kab_kota']  = $this->input->post('kab_kota');

    $this->md_ekspedisi->addDestinasi($data);

    // Add log
    $aksi = 'Tambah Master Data';
    $ket  = 'Menambahkan data Kabupaten/Kota - ' . $data['kab_kota'] . ', Provinsi - ' .$data['provinsi'];
    addlog($aksi, $ket);

    ajaxReturnDie('success', 'Data Berhasil Ditambahkan', 'reload_table');
}

public function editDestinasi($param1)
{
    grantAccessFor('all');
    $id = decrypt($param1);
    $dt = $this->md_ekspedisi->getByIdDestinasi($id);
    foreach ($dt as $row) {
        $row->id = encrypt($row->id);
    }
    echo json_encode($dt);
    die;
}


public function updateDestinasi()
{        
    grantAccessFor('all');
    $id = decrypt($this->input->post('id_ekspedisi'));
    $data['provinsi']     = $this->input->post('provinsi', TRUE);
    $data['kab_kota']     = $this->input->post('kab_kota', TRUE);
           
    $this->md_ekspedisi->updateDestinasi($id, $data);

    /** LOG */
    addLog('Ekspedisi Kab Kota', 'Memperbarui Kab Kota "' . $data['kab_kota'] . '"');
    ajaxReturnDie('success', 'Data berhasil diperbarui', TRUE);
}





public function paginationDestinasi()
    {
        grantAccessFor('all');

        $dt    = $this->md_ekspedisi->getAllDestinasi();
        $start = $this->input->post('start');
        $data  = array();
        foreach ($dt['data'] as $row) {
             $id       = encrypt($row->id);
            if(sessPenggunaId() == 1 || sessPenggunaId() == 15 || sessPenggunaId() == 33 || sessPenggunaId() == 7 || sessPenggunaId() == 749 || sessPenggunaId() == 73 || sessPenggunaId() == 23 || sessPenggunaId() == 763) {
            $li_btn   = '
                <div class="btn-group" role="group" aria-label="First group">
                    <button type="button" class="btn btn-sm btn-primary btn-edit" data-id="' . $id . '"><i class="bx bx-pencil"></i></button>
                    <button type="button" class="btn btn-sm btn-danger btn-delete" title="Hapus Data" data-id="' . $id . '" data-object="ekspedisi/deleteDestinasi"><i class="bx bx-trash"></i></button>
                </div>';
            }else{
                $li_btn   = ""; 
            }


        $th = array();
        $th[] = ++$start . '.';
        $th[] = $row->provinsi;
        $th[] = $row->kab_kota;
        $th[] = $li_btn;
        $data[] = $th;
        }
        $dt['data'] = $data;
        echo json_encode($dt);
        die;
    }


public function deleteDestinasi($param1)
    {
        grantAccessFor('all');
        
        $id = decrypt($param1);
        $dtLaporan = $this->md_ekspedisi->getByIdDeleteDestinasi($id);
        $detail    = $dtLaporan->kab_kota;

        // Langsung hapus data
        $this->md_ekspedisi->deleteDestinasi($id);


        addLog('Ekspedisi Kab Kota', 'Menghapus Ekspedisi Kab Kota : ' . $detail);
        ajaxReturnDie('success', 'Laporan berhasil dihapus', TRUE);
    }


public function importDestinasi() {
    $file_mimes = array(
        'application/octet-stream', 'application/vnd.ms-excel', 'application/x-csv',
        'text/x-csv', 'text/csv', 'application/csv', 'application/excel',
        'application/vnd.msexcel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
    );

    if (isset($_FILES['berkas_excel']['name']) && in_array($_FILES['berkas_excel']['type'], $file_mimes)) {
        $arr_file = explode('.', $_FILES['berkas_excel']['name']);
        $extension = end($arr_file);

        if ('csv' == $extension) {
            $reader = new \PhpOffice\PhpSpreadsheet\Reader\Csv();
        } else {
            $reader = new \PhpOffice\PhpSpreadsheet\Reader\Xlsx();
        }

        $spreadsheet = $reader->load($_FILES['berkas_excel']['tmp_name']);
        $sheetData = $spreadsheet->getActiveSheet()->toArray();

        for ($i = 2; $i < count($sheetData); $i++) {
            $id = isset($sheetData[$i][0]) ? $sheetData[$i][0] : null;

            $data = [
                'provinsi'  => isset($sheetData[$i][1]) ? $sheetData[$i][1] : '',
                'kab_kota'  => isset($sheetData[$i][2]) ? $sheetData[$i][2] : '',
            ];

            if (empty($data['provinsi']) && empty($data['kab_kota'])) {
                continue;
            }

            if (!empty($id) && $this->md_ekspedisi->cekDestinasiExist($id)) {
                // Update jika id sudah ada
                $this->md_ekspedisi->updateDestinasi($id, $data);
            } else {
                // Insert baru
                $data['id'] = $id; // Jika ID diberikan di Excel
                $this->md_ekspedisi->addDestinasi($data);
            }
        }

        // Log aktivitas
        addlog('Edit Master Data', 'Melakukan Import Ekspedisi Destinasi');
        redirect('/ekspedisi/show/list/destinasi');
    }
}


public function exportDestinasi()
{
    $data = $this->md_ekspedisi->getAllDestinasiExport();

    $spreadsheet = new Spreadsheet;
    $sheet = $spreadsheet->getActiveSheet();

    // Style header kolom
    $style_col = [
        'font' => ['bold' => true],
        'alignment' => [
            'horizontal' => \PhpOffice\PhpSpreadsheet\Style\Alignment::HORIZONTAL_CENTER,
            'vertical' => \PhpOffice\PhpSpreadsheet\Style\Alignment::VERTICAL_CENTER
        ],
        'borders' => [
            'top' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'right' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'bottom' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'left' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN]
        ]
    ];

    // Style isi tabel
    $style_row = [
        'alignment' => [
            'vertical' => \PhpOffice\PhpSpreadsheet\Style\Alignment::VERTICAL_CENTER
        ],
        'borders' => [
            'top' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'right' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'bottom' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN],
            'left' => ['borderStyle' => \PhpOffice\PhpSpreadsheet\Style\Border::BORDER_THIN]
        ]
    ];

    // Judul
    $sheet->setCellValue('A1', "Format Data Kabupaten Kota (Jika ingin menambah Data, silahkan isi dibaris paling bawah, ID nya kosongkan saja");
    $sheet->mergeCells('A1:C1');
    $sheet->getStyle('A1')->getFont()->setBold(true);

    // Header kolom
    $sheet->setCellValue('A2', 'ID');
    $sheet->setCellValue('B2', 'Provinsi');
    $sheet->setCellValue('C2', 'Kabupaten Kota');
    $sheet->getStyle('A2')->applyFromArray($style_col);
    $sheet->getStyle('B2')->applyFromArray($style_col);
    $sheet->getStyle('C2')->applyFromArray($style_col);

    // Data
    $startRow = 3;
    $kolom = $startRow;
    foreach ($data as $item) {
        $sheet->setCellValue('A' . $kolom, $item->id);
        $sheet->setCellValue('B' . $kolom, $item->provinsi);
        $sheet->setCellValue('C' . $kolom, $item->kab_kota);

        $sheet->getStyle('A' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('B' . $kolom)->applyFromArray($style_row);
        $sheet->getStyle('C' . $kolom)->applyFromArray($style_row);

        $kolom++;
    }

    // Set ukuran kolom
    $sheet->getColumnDimension('A')->setWidth(7);
    $sheet->getColumnDimension('B')->setWidth(40);
    $sheet->getColumnDimension('C')->setWidth(65);
    $sheet->getDefaultRowDimension()->setRowHeight(-1);
    $sheet->getPageSetup()->setOrientation(\PhpOffice\PhpSpreadsheet\Worksheet\PageSetup::ORIENTATION_LANDSCAPE);
    $sheet->setTitle("Kabupaten Kota");

    // Proteksi sheet
    $sheet->getProtection()->setSheet(true);
    $sheet->getProtection()->setPassword('12345');

    // Buka kunci kolom B dan C baris 3 sampai 1000 agar bisa input data baru
    $sheet->getStyle('B3:B1000')->getProtection()->setLocked(\PhpOffice\PhpSpreadsheet\Style\Protection::PROTECTION_UNPROTECTED);
    $sheet->getStyle('C3:C1000')->getProtection()->setLocked(\PhpOffice\PhpSpreadsheet\Style\Protection::PROTECTION_UNPROTECTED);

    ob_end_clean();
    $filename = "Format Data Kabupaten Kota.xlsx";
    header('Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    header("Content-Disposition: attachment; filename=\"$filename\"");
    header('Cache-Control: max-age=0');
    $writer = new Xlsx($spreadsheet);
    $writer->save('php://output');
}


