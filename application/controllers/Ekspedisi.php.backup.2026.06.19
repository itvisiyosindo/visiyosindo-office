        $th[] = ($row->jkt !== null && $row->jkt !== '') ? 'Rp ' . number_format($row->jkt, 0, ',', '.') : '-';
        $th[] = ($row->est_jkt !== null && $row->est_jkt !== '' && $row->est_jkt != 0) ? $row->est_jkt.' Hari' : '-';
        $th[] = ($row->jogja !== null && $row->jogja !== '') ? 'Rp ' . number_format($row->jogja, 0, ',', '.') : '-';
