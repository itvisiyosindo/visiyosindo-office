    }


public function paginationOngkirByAsal()
{
    $asal = $this->input->post('asal');
    $data = $this->md_ekspedisi->getAllPricelistByAsal($asal);

    $start = $this->input->post('start');
    $final = [];
    foreach ($data['data'] as $row) {
        $newRow = [
            'no' => ++$start,
            'provinsi' => $row['provinsi'],
            'kab_kota' => $row['kab_kota'],
        ];

        foreach ($row['harga'] as $i => $val) {
            $newRow['ekspedisi_' . $i] = $val;
        }
        foreach ($row['estimasi'] as $i => $val) {
            $newRow['estimasi_' . $i] = $val;
        }


        $final[] = $newRow;
    }

    echo json_encode([
        'draw' => $data['draw'],
        'recordsTotal' => $data['recordsTotal'],
        'recordsFiltered' => $data['recordsFiltered'],
        'data' => $final
    ]);
}




