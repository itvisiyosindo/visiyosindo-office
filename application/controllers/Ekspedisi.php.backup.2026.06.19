public function show($param = "", $param2 = "", $param3 = "", $param4 = "")
    {
        grantAccessFor('all');
        if($param == 'list'){  
          if ($param2 == 'ekspedisi'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']  	= 'ekspedisi/v_ekspedisi';
            $page_data['page_title']	= 'Ekspedisi';
            $page_data['page_desc']  	= 'Master Data Ekspedisi';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'destinasi'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_destinasi';
            $page_data['page_title']    = 'Kab/Kota';
            $page_data['page_desc']     = 'Master Data Kab/Kota';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'acuan_ongkir'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_acuan_ongkir';
            $page_data['page_title']    = 'Berat & Acuan Ongkir';
            $page_data['page_desc']     = 'Master Data Berat dan Acuan Ongkir Maksimal';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'pricelist'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_pricelist';
            $page_data['page_title']    = 'Pricelist Ekspedisi';
            $page_data['page_desc']     = 'Master Data Pricelist Ekspedisi';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'berdasarkan_ekspedisi'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_nama_ekspedisi';
            $page_data['page_title']    = 'Perbandingan Ekspedisi';
            $page_data['page_desc']     = 'Berdasarkan Nama Ekspedisi';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'berdasarkan_barang'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_nama_barang';
            $page_data['page_title']    = 'Perbandingan Ekspedisi';
            $page_data['page_desc']     = 'Berdasarkan Nama Barang';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'berdasarkan_barang2'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['page_name']     = 'ekspedisi/v_nama_barang2';
            $page_data['page_title']    = 'Perbandingan Ekspedisi';
            $page_data['page_desc']     = 'Berdasarkan Nama Barang';
            $this->load->view('index', $page_data);
          }
        }else if($param == 'detail'){
          if($param2 == 'pricelist'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['id_ekspedisi']  = $param3;
            $page_data['data_ekspedisi']   = $this->md_ekspedisi->getByIdEkspedisi($param3);
            $page_data['page_name']     = 'ekspedisi/v_detail_pricelist';
            $page_data['page_title']    = 'Pricelist Ekspedisi';
            $page_data['page_desc']     = 'Master Data Pricelist Ekspedisi';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'berdasarkan_ekspedisi') {
            $page_data['switch'] = $this->id_navbar();
            $page_data['asal'] = $param3;

            // Ambil nama ekspedisi sesuai asal (pku/jkt/jogja)
            $page_data['nama_ekspedisi'] = $this->db->query("
                SELECT e.id_ekspedisi, e.nama_ekspedisi
                FROM ekspedisi e
                INNER JOIN ekspedisi_pricelist p ON p.id_ekspedisi = e.id_ekspedisi
                WHERE p.$param3 IS NOT NULL AND p.$param3 != ''
                GROUP BY e.id_ekspedisi
                ORDER BY e.nama_ekspedisi ASC
            ")->result();

            $page_data['page_name']  = 'ekspedisi/v_detail_nama_ekspedisi';
            $page_data['page_title'] = 'Pricelist Ekspedisi';
            $page_data['page_desc']  = 'Berdasarkan Nama Ekspedisi';

            $this->load->view('index', $page_data);
        }else if ($param2 == 'berdasarkan_barang'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['asal'] = $param3;

            $page_data['destinasi'] = $this->db->select('id, kab_kota')->from('ekspedisi_destinasi')->group_by('kab_kota')->order_by('kab_kota', 'ASC')->get()->result();
            
            $page_data['id_acuan'] = $param4;
            $page_data['data_barang']   = $this->md_ekspedisi->getByIdBarang($param4);
            
            // 1. Pastikan data barang tidak kosong
    if (!empty($data_barang_array)) {
        $barang = $data_barang_array[0]; // Ambil object barang pertama

        // 2. Terapkan logika yang sama dengan 'paginationAcuanOngkir'
        if ($barang->acuan_berat == 1) {
            $page_data['berat'] = $barang->berat; // Ambil berat aktual
        } else if ($barang->acuan_berat == 2) {
            $page_data['berat'] = $barang->berat_dimensi; // Ambil berat dimensi
        } else {
            $page_data['berat'] = 0; // Beri nilai default jika belum di-set
        }
    } else {
        // 3. Beri nilai default jika data barang tidak ditemukan
        $page_data['berat'] = 0;
    }

            $page_data['page_name']     = 'ekspedisi/v_detail_nama_barang';
            $page_data['page_title']    = 'Perbandingan Ekspedisi';
            $page_data['page_desc']     = 'Berdasarkan Nama Barang';
            $this->load->view('index', $page_data);
          }else if ($param2 == 'berdasarkan_barang2'){
            $page_data['switch']      	= $this->id_navbar();
            $page_data['asal'] = $param3;

            // Ambil nama ekspedisi sesuai asal (pku/jkt/jogja)
            $page_data['nama_ekspedisi'] = $this->db->query("
                SELECT e.id_ekspedisi, e.nama_ekspedisi
                FROM ekspedisi e
                INNER JOIN ekspedisi_pricelist p ON p.id_ekspedisi = e.id_ekspedisi
                WHERE p.$param3 IS NOT NULL AND p.$param3 != ''
                GROUP BY e.id_ekspedisi
                ORDER BY e.nama_ekspedisi ASC
            ")->result();
            
            $page_data['id_acuan'] = $param4;
            $page_data['data_barang']   = $this->md_ekspedisi->getByIdBarang($param4);

            $page_data['page_name']     = 'ekspedisi/v_detail_nama_barang2';
            $page_data['page_title']    = 'Perbandingan Ekspedisi';
            $page_data['page_desc']     = 'Berdasarkan Nama Barang';
            $this->load->view('index', $page_data);
          }
		}
          


    }




