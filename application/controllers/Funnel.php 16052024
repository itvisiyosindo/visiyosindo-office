    function add_namaproduct($idkategori){
        $query = $this->db
         ->select('b.id_kategori,b.nama_kategori,a.*')
         ->from('barang a')
         ->join('kategori_barang b','a.id_kategori=b.id_kategori')
         ->where('a.id_kategori',$idkategori)
         ->where('a.status',1)
         ->order_by('a.nama_barang', 'ASC')
         ->get();
        //$query = $this->db->get_where('pelanggananmodality',array('id_pelanggan'=>$id_cust));
        $data = "<option value=''>- Pilih Nama Product -</option>";
        foreach ($query->result() as $value) {
            $data .= "<option value='".$value->id_barang."'>".$value->nama_barang."</option>";
        }
            echo $data;
    }

     function add_namaproduct2($idkategori,$idproduct){
        $query = $this->db
         ->select('b.id_kategori,b.nama_kategori,a.*')
         ->from('barang a')
         ->join('kategori_barang b','a.id_kategori=b.id_kategori')
         ->where('a.id_kategori',$idkategori)
         ->where('a.status',1)
         ->order_by('a.nama_barang', 'ASC')
         ->get();
        //$query = $this->db->get_where('pelanggananmodality',array('id_pelanggan'=>$id_cust));
        $data = "<option value=''>- Pilih Nama Product -</option>";
        foreach ($query->result() as $value) {
            if($value->id_barang==$idproduct){
                $data .= "<option value='".$value->id_barang."' selected>".$value->nama_barang."</option>";            
            }else{
                $data .= "<option value='".$value->id_barang."'>".$value->nama_barang."</option>";
            }
        }
            echo $data;
    }

   

