<?php

use FontLib\Table\Type\post;
use PhpOffice\PhpSpreadsheet\Spreadsheet;
use PhpOffice\PhpSpreadsheet\Writer\Xlsx;

defined('BASEPATH') or exit('No direct script access allowed');

class Stock_opname extends CI_Controller
{
    function __construct()
    {
        parent::__construct();
        date_default_timezone_set('Asia/Jakarta');
        $this->load->model('md_stock_opname');
        $this->load->model('md_gudang');
        $this->load->model('md_pelanggan');
        $this->load->model('md_pengguna');
        $this->load->model('md_prov_kota');
        $this->load->model('md_kategori_tiket');
        $this->load->model('md_barang');
        $this->load->model('md_penerimaan_stok');
        $this->load->model('md_pengiriman_stok');
        $this->load->model('md_detail_barang_penerimaan_stok');
        $this->load->model('md_detail_barang');
        $this->load->helper('terbilang_helper');
        $this->load->helper('tanggal_helper');
        $this->load->helper('whatsapp_helper');
        $this->load->helper('encrypt_helper');
    }
	
	function id_navbar(){
		$id_navbar = "inventory";
		return $id_navbar;
	}

    public function index()
    {
        grantAccessFor('all');

        $page_data['switch']      	    = $this->id_navbar();
		$page_data['page_name']         = 'stock_opname/v_stock_opname';
        $page_data['page_title']        = 'Stock Opname';
        $page_data['page_desc']         = 'Management Data Stock Opname';
        $page_data['gudang']  		    = $this->md_gudang->getByWhere(['g.status' => 1]);
        $page_data['list_nama']         = $this->md_stock_opname->getBywhereActive();
		$page_data['nama_marketing']    = $this->md_pengguna->getPenggunaMarketing();
        $this->load->view('index', $page_data);
    }


    public function show($param = "", $param2 = "", $param3 = "")
    {
        grantAccessFor('all');
        if ($param == 'detail_so') {
			      $page_data['switch']      		  = $this->id_navbar();
            $id                             = decrypt($param2);
            $page_data['stock_opname'] 	    = $this->md_stock_opname->getAllSO($id);
            $page_data['stock_opname_detail'] 	    = $this->md_stock_opname->getAllSODetail($id);
            $page_data['page_name']       	= 'stock_opname/v_detail_so';
            $page_data['page_title']      	= 'Stock Opname';
            $page_data['page_desc']       	= 'Detail Perintah Stock Opname';
            $this->load->view('index', $page_data);
			
        }else if ($param == 'test'){
            
			      $page_data['switch']      		= $this->id_navbar();
            $id_gudang = 6;

            $page_data['total_stok'] = $this->md_stock_opname->getStokByGudangId($id_gudang);
            
            

            // Tampilkan data, misalnya ke view
            $page_data['page_name']       	= 'stock_opname/v_test';
            $page_data['page_title']      	= 'Pelanggan';
            $page_data['page_desc']       	= 'Detail Pelanggan';
            $this->load->view('index', $page_data);
        }


    }


    

    public function add()
    {
        grantAccessFor('all');

        $this->md_stock_opname->reset_increment("surat_kendaraan");
              $idFpp      = $this->md_stock_opname->getStockKodeId();
              $ambilId    = $idFpp->id;
              $ambilId    = ($ambilId+1);
              $panjangId  = strlen($ambilId);
              
              if ($panjangId == 1){
                $kodeFpp = "00".$ambilId;
              } else if ($panjangId == 2){
                $kodeFpp = "0".$ambilId;
              } else{
                $kodeFpp = $ambilId;
              }
              
              $bln = ambil_bln();
              $tahun = ambil_tahun();
              
              $kodeFpp = "SO.".$tahun.".".$bln.".".$kodeFpp;
              $data['kode']			     = $kodeFpp;
              
              $data['id_pengaju']    = sessPenggunaId();
              $data['tanggal_mulai'] = date_db_format($this->input->post('tanggal_mulai', TRUE));
              $data['id_gudang']     = $this->input->post('id_gudang', TRUE);
              $data['id_pelaksana']  = $this->input->post('id_pelaksana', TRUE);
              $data['keterangan']    = $this->input->post('keterangan', TRUE);
              $data['status']        = 0;
              $this->md_stock_opname->addStockOpname($data);


              // Data Stok Barang
              $lastGcId = $this->md_stock_opname->getSoLastId();
              $lastGcId = $lastGcId->id_so;
              
              $this->md_stock_opname->reset_increment("stock_opname_detail");
              $dataDetailGc['id_so']			= $lastGcId;
              
              $dt = $this->md_stock_opname->getAllBarang();
              $dt_gudang = $this->md_gudang->getByWhere(['g.id_gudang'=>$data['id_gudang']]);
              $i = 0; $x = 0; 
              foreach ($dt as $row) {
                  $id = $row->id_barang;
                  
                  // Loop untuk mendapatkan stok per gudang
                  foreach($dt_gudang as $row2) {
                      $i++;
                      $stock[$i] = $this->md_barang->getStokByBarangIdGudangId($id,$row2->id_gudang);
                  }

                  $barang = $row->nama_barang;
                  foreach($dt_gudang as $row3) {
                      $x++;
                      $stock_office = $stock[$x] ? $stock[$x][0]->total_stock : 0;
                      
                      // Stok yang 0 tidak disimpan
                      if ($stock_office > 0) {
                          $dataDetailGc['id_barang'] = $id;
                          $dataDetailGc['stok_office'] = $stock_office;
                          $this->md_stock_opname->addStockOpnameDetail($dataDetailGc);
                      }
                  }
              }

                  
              
                 
             if($dt_gudang[0]->jenis == 1){
              //  if ($dt_gudang[0]->jenis == 1 && $dt_gudang[0]->id_gudang != 2) {

              
                //Notif Wa ke grup Gudang

                $idSo           = encrypt($lastGcId);
                $dataPelaksana 	= $this->md_pengguna->getById($data['id_pelaksana']);
                $namaPelaksana  = $dataPelaksana[0]->nama;

                $dataPengaju 	= $this->md_pengguna->getById($data['id_pengaju']);
                $namaPengaju    = $dataPengaju[0]->nama;

                $namaGudang  = $dt_gudang[0]->nama_gudang;
                    

                    
                    $dataWa = [
                      //'idPenerima1' 	=> 'Test Api Wa Group',
                      //'idPenerima2' 	=> 'Test2',
                      'idPenerima1' 	=> 'Gudang PT. VYM',
                      'idPenerima2' 	=> '',
                      'namaSurat'  	    => 'Stock Opname',
                      'statusSurat' 	=> 'Perintah',
                      'pelaksana' 	    => $namaPelaksana,
                      'namaPengaju' 	=> $namaPengaju,
                      'status' 	        => 'mengajukan',
                      'kode' 	        => $kodeFpp,
                      'idSo' 	        => $idSo,
                      'gudang' 	        => $namaGudang
                  ];
                  $this->notifWaAppGudangGroup(1, $dataWa);


                } 
 

              /** LOG */
              addLog('Pengajuan Stock Opname', 'Permintaan Stock Opname dengan Kode : '.$kodeFpp);
              ajaxReturnDie('success', 'Berhasil Diajukan', TRUE);
    }


    public function delete($param)
    {
        grantAccessFor('all');

        $id      = decrypt($param);
        $data['status'] = 9;
        $this->md_stock_opname->updateSo(['id_so' => $id], $data);

        //add log
        $aksi = 'Hapus Stock Opname';
        $ket = 'Menghapus data Stock Opname';
        addlog($aksi, $ket);

        ajaxReturnDie('success', 'berhasil dihapus', 'reload_table');
    }

    public function updateStok()
    {
        grantAccessFor('all');

        //update detail Stok Opname
        $id_sodetail = $this->input->post('id_sodetail');
        foreach ($id_sodetail as $key => $row) {
            if(sessPenggunaId() == '15' || sessPenggunaId() == '722'){
            $data['stok_office'] = $this->input->post('stok_office')[$key];
            }
            $data['stok_accurate'] = $this->input->post('stok_accurate')[$key];
            $data['stok_gudang'] = $this->input->post('stok_gudang')[$key];

            
            $this->md_stock_opname->updateSoDetail(['id' => decrypt($row)], $data);
            

        }
        //add log
        $aksi = 'Isi Stok';
        $ket = 'Mengisi Stok Accurate dan Gudang';
        addlog($aksi, $ket);

        ajaxReturnDie('success', 'Data Berhasil Ditambahkan', TRUE);
    }

  

    public function pagination()
    {
        grantAccessFor('all');

        $dt    = $this->md_stock_opname->getAllStockOpname();
        $start = $this->input->post('start');
        $data  = array();
        foreach ($dt['data'] as $row) {
            //$status 	= $row->status == 1 ? '<span class="badge badge-ecommerce badge-success">Aktif</span>' : '<span class="badge badge-ecommerce badge-success">Baru Diajukan</span>';
            if($row->status == "0"){
				$status = '<span class="badge badge-ecommerce badge-info">Baru Diajukan</span>';
			}else if($row->status == "1"){
				$status = '<span class="badge badge-ecommerce badge-success">Disetujui Penanggung Jawab</span>';
			}else if($row->status == "2"){
				$status = '<span class="badge badge-ecommerce badge-success">Disetujui PJT</span>';
			}else{
				$status = '<span class="badge badge-ecommerce badge-danger">Ditolak</span>';
			}
            
            $id       	= encrypt($row->id_so);
            $li_btn   	= '
                <div class="btn-group" role="group" aria-label="First group">
                   <!-- <button type="button" class="btn btn-sm btn-primary btn-edit" data-id="' . $id . '"><i class="bx bx-pencil"></i></button> -->
                   <button type="button" class="btn btn-sm btn-danger btn-delete" title="Hapus Data" data-id="'.$id.'" data-object="stock_opname/delete/'.$id.'"><i class="bx bx-trash"></i></button>
                </div>';
                
            $kode  = '<a href="stock_opname/show/detail_so/' . $id . '")>' . $row->kode . '</a>';
            $th = array();
            $th[] = date('d-m-Y',strtotime($row->created_at));
            $th[] = $kode;
            $th[] = date('d-m-Y',strtotime($row->tanggal_mulai));
            $th[] = $row->nama_gudang;
            $th[] = $status;
            $th[] = $row->keterangan;
            $th[] = $row->nama_pelaksana;
            $th[] = $row->nama_pengaju;
            if(sessPenggunaId() == 722 || sessPenggunaId() == 15 || sessPenggunaId() == 769 || sessPenggunaId() == 1 || sessPenggunaId() == 7){
                $th[] = $li_btn;
            }else{
                $th[] = "";
            }
            $data[] = $th;

        }
        
        $dt['data'] = $data;
        echo json_encode($dt);
        die;
    }


    public function print($param = "", $param2 = ""){
       
        $data['stock_opname'] 	        = $this->md_stock_opname->getAllSO(decrypt($param2));
        $data['stock_opname_detail'] 	  = $this->md_stock_opname->getAllSODetail(decrypt($param2));
        if($param == '1'){
            $this->load->view('pages/v_print/print_stock_opname', $data);
        }else if($param == '2'){
            $this->load->view('pages/v_print/print_stock_opname_finish', $data);
        }
    }



    


    public function ttd_setujui($param1="", $param2="", $param3=""){
    	grantAccessFor('all');
        
      if($param1 == "ttd_1"){
                
				$id = $this->input->post('id');
				$data['ttd_1'] = 1;
                $data['status'] = 1;
                $this->md_stock_opname->updateSo(['id_so' => $id], $data);

        
                    
                    $dt_so = $this->md_stock_opname->getAllSO($id);
                    $namaGudang  = $dt_so[0]->nama_gudang;
                    $namaPelaksana  = $dt_so[0]->nama_pelaksana;
                    $kodeFpp  = $dt_so[0]->kode;  
                    $idSo           = encrypt($id);
                        
                    
                    $ambilDataPenolak 	= $this->md_pengguna->getById(sessPenggunaId());
                    $namaPenolak	    = $ambilDataPenolak[0]->nama;

                    
                    $dataWa = [
                      //'idPenerima1' 	=> 'Test Api Wa Group',
                      //'idPenerima2' 	=> 'Test2',
                      'idPenerima1' 	=> '1',
                      'idPenerima2' 	=> '7',
                      'namaSurat'  	    => 'Stock Opname',
                      'statusSurat' 	=> 'Persetujuan Perintah',
                      'pelaksana' 	    => $namaPelaksana,
                      'namaPengaju' 	=> $namaPenolak,
                      'status' 	        => 'menyetujui',
                      'kode' 	        => $kodeFpp,
                      'idSo' 	        => $idSo,
                      'gudang' 	        => $namaGudang
                  ];
                  $this->notifWaAppStockOpname(2, $dataWa); 

              /** LOG */
              addLog('Persetujuan Stock Opname', 'Persetujuan Stock Opname dengan Kode : '.$kodeFpp);
              ajaxReturnDie('success', 'Berhasil', TRUE);

       }

    }

