	public function laporan_update($param1="", $param2="", $param3="", $param4=""){
		grantAccessFor('all');
		if($param1 == "pb"){
			//update tgl_laporan on surat_biaya_dinas
			$id_pb = decrypt($this->input->post('id_pb'));
			$data['tgl_laporan'] = date_db_format($this->input->post('pengajuan', TRUE));
			$data['lampiran_laporan'] = $this->input->post('lampiran', TRUE);
			$this->md_surat_list->update_pb($id_pb, $data);
			
			//update status surat
			$this->md_surat_list->update_surat_list('1', $id_pb, '2');
			
			//add detail laporan to surat_detail_biaya_dinas
			$this->md_surat_list->reset_increment("surat_detail_biaya_dinas");
			$itung = $this->input->post('itung', TRUE);
			$dataDetailPB['id_pb']			= $id_pb;
			$dataDetailPB['kode_laporan']	= 2;
			if($itung > 0){
				for($x=1;$x<$itung;$x++){
					$dataDetailPB['keterangan']	= $this->input->post('keterangan['.$x.']', TRUE);
					$dataDetailPB['tanggal']	= date_db_format($this->input->post('tanggal['.$x.']', TRUE));
					$dataDetailPB['nominal']	= $this->input->post('nominal['.$x.']', TRUE);
					$this->md_surat_list->addSurat('dpb', $dataDetailPB);
				}
			}
			
			//dataPb
			$ambilDataPb    = $this->md_surat_list->getPBById($id_pb);
			$perihal        = $ambilDataPb[0]->perihal;
			$kode           = $ambilDataPb[0]->kodePB;
			
			//send notif wa
			$dataWa = [
            	'id' 	        => $id_pb,
                'idPenerima1' 	=> 58,
                'idPenerima2' 	=> '',
            	'namaSurat' 	=> 'Laporan Surat Biaya Perjalanan Dinas',
            	'penerima' 	    => 'General Affair',
            	'perihal' 	    => $perihal,
            	'kode'          => $kode
            ];
			$this->notifWaAddSurat(1, $dataWa);
			
			addLog('Update Laporan Biaya Dinas', 'Submit Laporan Biaya Perjalanan Dinas');
			ajaxReturnDie('success', 'Laporan Biaya Perjalanan Dinas Berhasil Disubmit');
			
		}if($param1 == "kg"){
			//update link laporan
			$id = decrypt($this->input->post('id_kg'));
			$data['laporan'] = $this->input->post('laporan', TRUE);
			$this->md_surat_list->update_kg($id, $data);
			
			//update status surat
			$this->md_surat_list->update_surat_list('6', $id, '2');
			
			//dataPb
			$ambilData    = $this->md_surat_list->getKGById($id);
			$perihal        = $ambilData[0]->perihal;
			$kode           = $ambilData[0]->kode;
			
			//send notif wa
			$dataWa = [
            	'id' 	        => $id,
                'idPenerima1' 	=> 58,
                'idPenerima2' 	=> 1,
            	'namaSurat' 	=> 'Laporan Kunjungan Gudang',
            	'penerima' 	    => 'General Affair',
            	'perihal' 	    => $perihal,
            	'kode'          => $kode
            ];
			$this->notifWaAddSurat(2, $dataWa);
			
			//addLog('Update Laporan Kunjungan Gudang', 'Submit Laporan Kunjungan Gudang');
			ajaxReturnDie('success', 'Laporan Kunjungan Gudang Berhasil Disubmit', true);
		}
	}

