            }
        }

        //destroy temp data
        $this->md_pengeluaran_barang->destroyTempData();
        if ($this->db->trans_status() === TRUE) {
            //jika tarik dari invoice
            if ($this->input->post('id_invoice')) {
                //////cek dan update status_barang_keluar///////
