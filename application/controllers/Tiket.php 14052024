    public function nopeAdmin($select){
	    if($select == 'ga'){
	        $dataAdmin 	= $this->md_pengguna->getById(1);
            $nopeAdmin  = $dataAdmin[0]->no_hp;
	    }else if($select == 'financeStaff'){
