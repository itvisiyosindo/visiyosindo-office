    public function pagination(){ 
        grantAccessFor('all');

        $dt = $this->md_barang->getAll();
        //$dt_gudang = $this->md_gudang->getByWhere(['g.status'=>1]);
        $dt_gudang = $this->md_gudang->getBywhereInOri(['g.status'=>1]);
        $dt_transit = $this->md_detail_barang_pengiriman_stok->get(['status' => 1]);
        $start = $this->input->post('start');
        $data  = array();
        $i = 0; $x = 0; $a = 0; $b = 0;
        foreach ($dt['data'] as $row) {
            $id       = $row->id_barang;
            foreach($dt_gudang as $row2) {
                $i++;
                $stock[$i] = $this->md_barang->getStokByBarangIdGudangId($id,$row2->id_gudang);
            }

            foreach($dt_transit as $row4){
                $a++;
                $transit[$a] = $this->md_barang->getStokByBarangIdPEngirimanStok($id);
            }

            $th = array();
            // $th[] = ++$start . '.';
            $th[] = $row->nama_barang;
            foreach($dt_gudang as $row3){
                $x++;
                $th[] = $stock[$x] ? $stock[$x][0]->total_stock : 0;
            }
            foreach($dt_transit as $row5){
                $b++;
                $th[] = $transit[$b][0]->total_transit ? $transit[$b][0]->total_transit : 0;
            }
            $data[] = $th;
        }
        
        $dt['data'] = $data;
        echo json_encode($dt);
        die;
       

    }


