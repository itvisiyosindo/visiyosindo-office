        $this->load->model('md_funnel');
    }
	
	function id_navbar(){
		$id_navbar = "marketing";
		return $id_navbar;
	}


  

   public function chart_data()
    {
        // Ambil data dari model
        $jumlah_id = $this->md_funnel->get_jumlah_id_per_bulan();

        // Persiapkan array untuk menyimpan data yang terstruktur
        $result = [];
        foreach ($jumlah_id as $row) {
            // Inisialisasi bulan jika belum ada
            if (!isset($result[$row->bulan])) {
                $result[$row->bulan] = [
                    'month' => $row->bulan,
                    '105' => 0,
                    '742' => 0,
                    '745' => 0,
                ];
            }

            // Masukkan jumlah id sesuai dengan id marketing
            if ($row->idmarketing == 105) {
                $result[$row->bulan]['105'] = $row->jumlah_id;
            } elseif ($row->idmarketing == 742) {
                $result[$row->bulan]['742'] = $row->jumlah_id;
            } elseif ($row->idmarketing == 745) {
                $result[$row->bulan]['745'] = $row->jumlah_id;
            }
        }

        // Kembalikan data dalam format JSON
        echo json_encode(array_values($result));
    }


